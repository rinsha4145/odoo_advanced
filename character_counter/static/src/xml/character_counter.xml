<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="character_counter.widget" owl="1">
        <div class="d-flex flex-column w-100 position-relation">
             <input
                    class="mb-1 o_input"
                    t-att-id="props.id"
                    type="text"
                    autocomplete="off"
                    t-att-placeholder="props.placeholder"
                    t-att-required="props.required"
                    t-ref="input"
                    t-on-input="onInputText"
                />
            <div class="form-helper text-end text-muted small pe-1">
                <span t-att-class="this.state.length &gt; (this.max_field - 10) ? 'text-danger' : 'text-info'">
                    <field t-esc="this.state.length"/>
            </span>/<field t-esc="this.max_field"/>
                    </div>
                </div>
    </t>
</templates>
