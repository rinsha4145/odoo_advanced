<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="dashboard_warehouse_info">
        <div class="card shadow-sm h-100">
            <!-- Card Header with Title and Two Dropdowns -->
            <div class="card-header d-flex justify-content-between align-items-center bg-white py-3">
                <h5 class="card-title mb-0 fw-bold">Warehouse's Location information</h5>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Warehouses Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton1"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            Warehouses
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                            <t t-foreach="this.state.warehouses" t-as="w" t-key="w_index">
                                <li>
                                    <a class="dropdown-item" href="#"
                                       t-on-click.prevent="() => this.onSelectItem(w.id)">
                                        <t t-esc="w.name"/>
                                    </a>
                                </li>
                            </t>
                            <li>
                                <a class="dropdown-item" href="#" t-on-click.prevent="() => this.onSelectItem(false)">
                                    None
                                </a>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>
            <t t-if="this.state.inventory_location[0]">
                <div class="table-responsive"  style="max-height: 300px; overflow-y: auto;">
                    <table class=" table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-3">SI No</th>
                                <th scope="col" class="text-center">Location</th>
                                <th scope="col" class="text-center">Parent Location</th>
                                <th scope="col">Type</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="this.state.inventory_location" t-as="l" t-key="l_index">
                                <tr>
                                    <td>
                                        <t t-esc="l_index + 1"/>
                                    </td>
                                    <td>
                                        <t t-esc="l.complete_name"/>
                                    </td>
                                    <td>
                                        <t t-esc="l.location_id"/>
                                    </td>
                                    <td>
                                        <t t-esc="l.usage"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
            <t t-else="">
                <p class="text-center text-muted py-4 mb-0">No Data</p>
            </t>
        </div>


    </t>
</templates>