<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="dashboard_view.InventoryDashboard">
        <div class="container-fluid py-4" style="height: 100%; overflow-y: auto;">
            <div class="text-center my-3">
                <h1 class="m-0" style="margin: 20px;">Inventory Dashboard</h1>
            </div>
            <t t-call="dashboard_filtering"/>
            <div class="d-flex flex-column gap-4">
                <div class="p-3" style="margin: 10px;">
                    <div class="row g-3 align-items-center">

                        <div class="card shadow-sm h-100 col-12 col-md-6">
                            <div style="position: relative; height: 450px; width: 100%;">
                                <canvas id="product_incoming_chart"/>
                            </div>
                        </div>
                        <div class="card shadow-sm h-100 col-12 col-md-6">
                            <div style="position: relative; height: 450px; width: 100%;">
                                <canvas id="product_outgoing_chart"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 align-items-stretch">
                    <div class="col-12 col-lg-6">
                        <t t-call="dashboard_warehouse_info"/>
                    </div>
                    <div class="col-12 col-lg-6">
                        <t t-call="dashboard_location_info"/>
                    </div>
                </div>
                <div class="p-3" style="margin: 10px;">
                    <div class="row g-3 align-items-center">
                        <div class="card shadow-sm h-100 col-12 col-md-6">
                            <div class="align-items-center" style="position: relative; height: 450px; width: 100%;">
                                <canvas id="avg_product_cost"/>
                            </div>
                        </div>
                        <div class="card shadow-sm h-100 col-12 col-md-6">
                            <div style="position: relative; height: 450px; width: 100%;">
                                <canvas id="group_by_picking_type"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-3" style="margin: 10px;">

                    <div class="card shadow-sm h-100 col-12 col-md-6">
                        <div class="align-items-center" style="position: relative; height: 450px; width: 100%;">
                            <canvas id="internal_tranfer_product_count"/>
                        </div>
                    </div>


                </div>
            </div>
        </div>
    </t>
</templates>
