<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="dashboard_view.InventoryDashboard">
        <div style="height: 100%; overflow-y: auto;">

            <div class="container-fluid p-4">
                <div class="text-center my-3">
                    <h1 style="margin:20px;">Inventory Dashboard</h1>
                </div>

                <!--            <t t-call='dashboard_cards'/>-->
                <div class="d-flex flex-column gap-4">

                    <div class="p-3" style="margin:10px;">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div style="position: relative; height: 300px; width: 100%;">
                                    <canvas id="product_incoming_chart" height="300px" width="300px"/>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div style="position: relative; height: 300px; width: 100%;">
                                    <canvas id="product_outgoing_chart" height="300px" width="300px"/>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
            <div class="d-flex flex-row gap-1">
                <t t-call="dashboard_warehouse_info"/>

                <t t-call="dashboard_location_info"/>

            </div>
            <div class="d-flex flex-row gap-4">
                <div class="col-md-6">
                    <div style="height: 300px; width: 100%;">
                        <canvas id="avg_product_cost" height="300px" width="100px"/>
                    </div>
                </div>
                <div class="col-md-6">
                    <div style="height: 300px; width: 100%;">
                        <canvas id="group_by_picking_type" height="300px" width="100px"/>
                    </div>
                </div>
            </div>
        </div>

    </t>
</templates>
