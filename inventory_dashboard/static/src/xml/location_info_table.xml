<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="dashboard_location_info">
        <div>
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton1"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    Warehouses
                </button>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                    <t t-foreach="this.state.warehouses" t-as="w" t-key="w_index">
                        <li>
                            <a class="dropdown-item" href="#" t-on-click.prevent="() => this.onSelectItem(w.id)">
                                <t t-esc="w.name"/>
                            </a>
                        </li>
                    </t>
                    <li>
                        <a class="dropdown-item" href="#" t-on-click.prevent="() => this.onSelectItem(false)">None</a>
                    </li>
                </ul>
            </div>
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">SI No</th>
                        <th scope="col">Location</th>
                        <th scope="col">Parent Location</th>
                        <th scope="col">Type</th>
<!--                        <th scope="col">Stock</th>-->
                    </tr>
                </thead>

                <tbody>
                    <t t-foreach="this.state.inventory_location" t-as="l" t-key="l_index">
                        <t t-log="this.state.inventory_location"/>
                        <tr>
                            <td>1</td>
                            <td><t t-esc="l.complete_name"/> </td>
                            <td><t t-esc="l.location_id"/> </td>
                            <td><t t-esc="l.usage"/> </td>
<!--                            <td><t t-esc="l.quant_ids.quantit"/> </td>-->

                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>
</templates>