<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <record id="fleet_vehicle_view_form_inherit_sevice" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.service</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
             <xpath expr="//div[@class='oe_title']" position="after">
                 <group>
                     <field name="service_blocked" string="Service Blocked" />
                 </group>
             </xpath>
        </field>
     </record>
</odoo>