<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_custom_room_model" model="ir.sequence">
        <field name="name">Custom Sequence</field>
        <field name="implementation">standard</field>
        <field name="code">fleet.service.order</field>
        <field name="prefix">FLEET/SER/</field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="action_fleet_service_order_template" model="ir.actions.act_window">
        <field name="name">Fleet Service Order</field>
        <field name="res_model">fleet.service.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_natural_face">Create Service</p>
        </field>
    </record>

    <record id="fleet_service_order_template_view_list" model="ir.ui.view">
        <field name="name">fleet.service.order.list</field>
        <field name="model">fleet.service.order</field>
        <field name="arch" type="xml">
            <list string="Employee Loan">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="technician_id"/>
                <field name="service_date"/>
                <field name="part_ids"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <!--FORM VIEW-->
    <record id="fleet_service_order_template_view_form" model="ir.ui.view">
        <field name="name">fleet.service.order.form</field>
        <field name="model">fleet.service.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statebar_visible="draft,confirmed,in_progress,done,cancelled"/>
                    <button
                            string="Confirm"
                            id="update"
                            type="object"
                            class="btn-primary"
                            name="action_state_change"
                            invisible="state not in ['draft']"
                    />
                    <button
                            string="Start"
                            id="start"
                            type="object"
                            class="btn-primary"
                            name="action_start"
                            invisible="state not in ['confirmed']"
                    />
                    <button
                            string="Generate"
                            id="start"
                            type="object"
                            class="btn-primary"
                            name="action_generate"
                            invisible="state not in ['confirmed']"
                    />
                    <button
                            string="Cancel"
                            id="cancel"
                            type="object"
                            name="action_cancel"
                              invisible="state in ['done']"
                    />
                </header>

                <sheet>
                    <div>

                        <div>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="service Details">
                                <field name="technician_id"/>
                                <field name="vehicle_id"   domain="domain"/>
                                <field name="type_ids" widget="many2many_tags"/>
                                <field name="service_date"  />


                            </group>
                            <group string=" Details">


                                <field name="parts_total"/>
                                <field name="labour_cost"  />

                                <field name="grand_total"/>
                                <field name="checklist_progress"/>
                            </group>
                        </group>
                    </div>
                    <notebook>
                        <page id="part_line" name="Part">

                            <field name="part_ids"
                            >
                                <list string="parts" editable="bottom">
                                    >
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>

                                </list>
                            </field>
                        </page>
                        <page id="checklist_line" name="Checklist">

                            <field name="checklist_ids"
                                   mode="list" readonly="state == 'done'">
                                <list string="checkilist" editable="bottom">

                                    <field name="task_name"/>
                                    <field name="is_done"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>