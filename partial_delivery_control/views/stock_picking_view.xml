<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_picking_form_inherit_view" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_validate' and contains(@invisible, 'draft')]" position="attributes">
                <attribute name="invisible">state in ('draft', 'confirmed','to_approve', 'done', 'cancel')</attribute>
            </xpath>
            <xpath expr="//button[@name='button_validate' and contains(@invisible, 'waiting')]" position="attributes">
                <attribute name="invisible">state in ('waiting','to_approve', 'assigned', 'done', 'cancel')</attribute>
            </xpath>

            <xpath expr="//button[@name='action_cancel']" position="before">
                <button
                        string="Approve"
                        name="action_approve"
                        id="approve_delivery"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                        invisible="state != 'to_approve'"
                        groups="partial_delivery_control.group_delivery_approval_user"
                />
                <button
                        string="Reject"
                        name="action_reject"
                        id="reject_delivery"
                        type="object"
                        invisible="state != 'to_approve'"
                        groups="partial_delivery_control.group_delivery_approval_user"

                />
            </xpath>
        </field>
    </record>
</odoo>