<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_form_inherit_view" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@id='pricing_setting_container']" position="inside">

                   <setting id="sale_order_approval" company_dependent="1" help="Limit the discount amount in sale order" title="limit discount amount">
                            <field name="so_order_approval"/>
                            <div class="content-group" invisible="not so_order_approval">
                                <div class="row mt16">
                                    <label for="so_double_validation_amount" class="col-lg-4 o_light_label"/>
                                    <field name="so_double_validation_amount"/>
                                </div>
                            </div>
                        </setting>
            </xpath>
        </field>
    </record>
</odoo>