<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_form_inherit_view" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@id='pricing_setting_container']" position="inside">
                <setting id="limit_discount" help="Limit the discount in sale order"
                         title="Sum of all the discount in sale order">
                    <field name="discount_limit"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>