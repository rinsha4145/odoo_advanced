<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">

                <button
                        string="Add to order line"
                        id="action_add_to_order_line"
                        name="action_add_to_order_line"
                        type="object"
                        class="btn-primary"
                        invisible="not selected_product_ids or product_quantity &lt; 1 or state != 'draft'"

                />
            </xpath>
            <xpath expr="//group[@name='order_details']" position="after">
                <group>
                    <field name="selected_product_ids"
                           widget="many2many_tags"
                    />

                </group>
                <group>

                    <field name="product_quantity"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>