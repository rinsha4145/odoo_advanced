<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="integration" position="inside">
                <setting id="weather" string="Weather API KEY"
                         placeholder="Add a your  API KEY"
                >
                    <field name="api_key" placeholder="Paste your Api Key"/>
                    <br/>
                     <a target="_blank" href="https://openweathermap.org/">
                            <i class="oi oi-arrow-right"/>
                            Get the API KEY from here
                        </a>
                </setting>

            </block>
        </field>
    </record>
</odoo>
