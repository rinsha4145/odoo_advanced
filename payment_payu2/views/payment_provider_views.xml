<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">PayU Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'payu2'">
                    <field name="payu2_api_key" string="API Key" required="code == 'payu2' and state != 'disabled'"
                           password="True"/>
                    <field string="Merchant Salt" name="payu2_salt_key" password="True" required="code == 'payu2' and state != 'disabled'"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
