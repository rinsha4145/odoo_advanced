<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_payu2" model="payment.provider">
        <field name="name">PayU2</field>
        <field name="code">payu2</field>
        <field name="state">test</field>
        <field name="module_id" ref="base.module_payment_payu2"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="image_128" type="base64" file="payment_payu2/static/description/icon.png"/>
        <field name="is_published">true</field>
        <field
                name="payment_method_ids"
                eval="[Command.set([
                ref('payment.payment_method_card'),
                ref('payment.payment_method_emi_india'),
                ref('payment.payment_method_netbanking'),
                ref('payment.payment_method_paylater_india'),
                ref('payment.payment_method_upi'),
                ref('payment.payment_method_wallets_india'),
            ])]"
        />
    </record>
</odoo>