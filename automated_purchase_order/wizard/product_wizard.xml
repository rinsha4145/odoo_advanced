<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_product_wizard" model="ir.actions.act_window">
        <field name="name">Add Price and Quantity</field>
        <field name="res_model">product.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="product_wizard_form" model="ir.ui.view">
        <field name="name">product.wizard.form</field>
        <field name="model">product.wizard</field>
        <field name="arch" type="xml">
            <form string="Add price and quantity">
                <group>
                    <field name="quantity"/>
                    <field name="price"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>