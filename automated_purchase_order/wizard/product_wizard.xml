<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_wizard_form" model="ir.ui.view">
        <field name="name">product.wizard.form</field>
        <field name="model">product.wizard</field>
        <field name="arch" type="xml">
            <form string="Add price and quantity">
                <group>
                    <field name="product_id" readonly="1"/>
                    <field name="quantity"/>
                    <field name="price"/>
                    <field name="vendor_id" readonly="1" force_save="1"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" class="btn-primary" name="action_confirm"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>