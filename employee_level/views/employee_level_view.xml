<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_employee_level_template" model="ir.actions.act_window">
        <field name="name">Employee Level</field>
        <field name="res_model">employee.level</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_natural_face">Create Type</p>
        </field>
    </record>
    <record id="view_employee_level_list" model="ir.ui.view">
        <field name="name">employee.level.list</field>
        <field name="model">employee.level</field>
        <field name="arch" type="xml">
            <list string="Employee Levels" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="level"/>
                <field name="salary"/>

            </list>
        </field>
    </record>
    <menuitem
            id="menu_employee_level_tree"
            action="action_employee_level_template"
            parent="hr.menu_config_employee"
            sequence="10"/>
</odoo>