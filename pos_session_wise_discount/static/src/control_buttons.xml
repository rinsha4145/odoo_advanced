<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_session_wise_discount.ControlButtons" t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[@t-if='pos.config.use_presets and !props.showRemainingButtons']"
               position="before">
            <span>Remaining discount amount:

    <t t-out="Math.max(0,(this.pos.config.discount_amount_limit - state.value).toFixed(2))"/></span>

        </xpath>
    </t>
</templates>
