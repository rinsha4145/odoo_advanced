<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pos_res_config_settings_form_inherit_view" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pos_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='down_payment_product']" position="after">
                <setting company_dependent="1"
                         help="Add a discount amount limit for this session">
                    <field name="discount_amount"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>